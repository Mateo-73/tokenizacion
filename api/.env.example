PORT=3001
MOCK_MODE=true                            # true: Stellar simulado, sin red · false: Stellar testnet real (necesita api/.stellar-keys.json)
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK=testnet
ADMIN_KEY=cambiar-por-un-valor-largo      # header x-admin-key para endpoints de admin
WEB_ORIGIN=http://localhost:5173           # origen permitido por CORS (en Vercel: https://<tu-app>.vercel.app)
# ⚠ Estas 4 líneas se completan con las claves públicas de api/.stellar-keys.json.
#   - Ejecuta `npm run setup:stellar` una vez: crea y fondea cuentas de prueba y genera ese archivo.
#   - El archivo de claves secretas NO está en git (nunca se sube).
#   - Si ya tienes un api/.stellar-keys.json, reutilízalo y no vuelvas a correr setup.
ISSUER_PUBLIC=
DISTRIBUTOR_PUBLIC=
TREASURY_PUBLIC=
USDC_ISSUER_PUBLIC=
